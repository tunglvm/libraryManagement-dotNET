<Window x:Class="libraryManagement.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:libraryManagement.Views"
        mc:Ignorable="d"
        Title="Hệ Thống Quản Lý Thư Viện Chuyên Nghiệp" Height="700" Width="1200" WindowStartupLocation="CenterScreen">

    <Grid Background="#E9E9E9">
        <TabControl TabStripPlacement="Top" Margin="5">

            <TabItem Header=" QUẢN LÝ KHO SÁCH " FontSize="14" FontWeight="Bold" Padding="15,8">
                <views:BookView/>
            </TabItem>

            <TabItem Header=" QUẢN LÝ MƯỢN - TRẢ " FontSize="14" FontWeight="Bold" Padding="15,8">
                <views:BorrowView/>
            </TabItem>

        </TabControl>
    </Grid>
</Window>